---
layout: false
---
<% const view = travel_model(site.data.new_zealand); %>
<!DOCTYPE html><html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title %> · <%= config.title %></title><meta name="description" content="<%= page.description %>">
<meta name="robots" content="noindex, nofollow"><link rel="canonical" href="<%= full_url_for(page.path) %>">
<meta property="og:type" content="website"><meta property="og:title" content="<%= page.title %>"><meta property="og:description" content="<%= page.description %>"><meta property="og:url" content="<%= full_url_for(page.path) %>">
<meta name="theme-color" content="#f7f5ee" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)">
<link rel="icon" href="<%= url_for(theme.favicon) %>"><link rel="stylesheet" href="/css/travel.css"><script defer src="/js/travel.js"></script>
</head><body data-default-plan="<%= view.defaultPlanId %>">
<a class="skip" href="#<%= view.defaultPlanId %>-timeline">跳至每日时间线</a>
<header class="sitebar"><a href="/" class="brand">AlmostKhan<span>旅行笔记</span></a><div><span class="edition">FIELD NOTES / 2026</span><button id="print-trip" type="button" hidden>打印 / 存为 PDF ↗</button></div></header>
<main>
<% if(view.mode==='compare') { %>
<div class="plan-overview">
<nav class="plan-switch" aria-label="比较旅行方案"><p class="eyebrow">两条路线，同一场旅行。</p><div class="plan-tabs"><% view.variants.forEach(trip=>{ %><a href="?plan=<%= trip.id %>#plan-<%= trip.id %>" data-plan-link="<%= trip.id %>" aria-controls="plan-<%= trip.id %>"><strong><%= trip.label %></strong><span><%= trip.direction %></span></a><% }) %></div><p id="plan-announcement" class="sr-only" aria-live="polite"></p></nav>
<section class="plan-costs" aria-label="两套方案预算对比"><% view.variants.forEach(trip=>{ %><article><p class="cost-label"><%= trip.label %><span>全队预算 · <%= view.assumptions.adults %> 人</span></p><p class="cost-amount"><small>¥</small><%= trip.source.totals.group_with_10pct_cny.map(n=>(n/10000).toFixed(2)).join('—') %><small>万</small></p><p class="cost-person">人均 ¥<%= trip.source.totals.person_with_10pct_cny.map(n=>Math.round(n).toLocaleString('zh-CN')).join('—') %></p></article><% }) %></section>
<p class="plan-budget-note">含境内机票与 10% 机动金；国际票实付、签证翻译、中国境内交通和待选项目另计。<span>方案比较中，尚未最终选定。</span></p>
</div>
<% } %>
<% view.variants.forEach(trip=>{ %><div class="plan-panel" id="plan-<%= trip.id %>" data-plan="<%= trip.id %>" aria-label="<%= trip.label %> <%= trip.direction %>">
<section class="hero" aria-labelledby="<%= trip.id %>-title"><div class="hero-copy"><p class="eyebrow">AOTEAROA / NEW ZEALAND · <%= trip.label %></p><h1 id="<%= trip.id %>-title">一路向南，<br>再去<span>中土。</span></h1><p class="intro"><%= trip.direction %>。<br>沿南岛湖山前行，自驾米尔福德，北岛报团走进夏尔，其他活动优先奥克兰市区。</p><div class="hero-meta"><span>2026.09.30 — 10.11</span><span><%= trip.days.length %> 天 · <%= trip.source.stays.reduce((n,s)=>n+s.nights,0) %> 晚</span><span><%= trip.label %> · <%= view.mode==='compare'?'比较草案':'选定方案' %></span></div><a class="primary" href="#<%= trip.id %>-timeline">展开每日行程 <span>↓</span></a></div>
<div class="route-art" aria-label="路线顺序示意，不代表真实地图或距离"><div class="route-art-top"><span>THE JOURNEY</span><span>南岛 <%= trip.source.south_nights %> 晚 / 北岛 <%= trip.source.north_nights %> 晚</span></div><ol class="route-spine"><% trip.routeStops.forEach((stop,i)=>{ %><li><span><%= String(i+1).padStart(2,'0') %></span><div><b><%= stop.title %></b><small><%= stop.detail %></small></div></li><% }) %></ol><p class="route-caption">路线顺序示意 · <%= trip.direction %></p></div></section>
<div class="status-strip"><span class="status-dot"></span><p><strong><%= view.mode==='compare'?'方案比较中，境内预订尚未锁位。':'方案已选定，预订状态逐项核实。' %></strong>更新于 <%= view.updated %>。国际票已购，实付待补；其余价格是预算或公开参考，余位不是实时结果。所有时刻按当地时间显示。</p></div>
<nav class="section-nav" aria-label="<%= trip.label %> 页面章节"><a href="/new-zealand/wishlist/">景点愿望排序 ↗</a><% [['timeline','每日时间线'],['bookings','活动报名'],['driving','车程与导航'],['flights','航班'],['stay','住宿与租车'],['prepare','预算与待办']].forEach(([key,label])=>{ %><a href="#<%= trip.id %>-<%= key %>"><%= label %></a><% }) %></nav>
<section class="attention" aria-label="关键衔接提醒"><article><span>01 / 固定住宿</span><h2>Te Anau 一晚，峡湾自驾</h2><p><%= trip.source.days.find(d=>d.activity_ids.includes('milford_self')).route %>。保留既定住宿，不安排峡湾大巴。</p></article><article><span>02 / 驾驶安排</span><h2>一位司机，逐日核对车程</h2><p><%= trip.source.days.find(d=>d.activity_ids.includes('milford_self')).driving_budget %>。分住 Te Anau 不等于峡湾日只开两三小时。</p></article><article><span>03 / 预算口径</span><h2>人均 ¥<%= trip.personBudget %></h2><p>暂按 <%= view.assumptions.adults %> 成人，含两段国内票及 10% 机动金；另加国际票实付、签证翻译、中国境内交通与自选项目。</p></article></section>
<section id="<%= trip.id %>-timeline" class="chapter"><div class="section-heading"><div><p class="eyebrow">01 / DAY BY DAY</p><h2>每天怎么走，都在这里。</h2></div><p>日期和住宿保持固定。<br>未购航班与活动时刻是目标。</p></div><div class="timeline-layout"><aside class="day-nav" aria-label="按日期跳转"><p>12 DAYS / 2026</p><% trip.days.forEach(day=>{ %><a href="#<%= day.id %>"><time datetime="<%= day.date %>"><%= day.short %></time><span><%= day.stay %></span></a><% }) %></aside><div class="days"><% trip.days.forEach((day,index)=>{ %><article class="day" id="<%= day.id %>" data-region="<%= day.region %>"><div class="day-top"><span class="day-number">DAY <%= String(index+1).padStart(2,'0') %></span><time datetime="<%= day.date %>"><%= day.short %></time><span class="region"><%= ({south:'南岛',north:'北岛',transit:'国际交通'})[day.region] %></span></div><h3><%= day.title %></h3><p class="day-place"><%= day.place %></p><div class="day-facts"><span><small>今晚住哪</small><b><%= day.stay %></b></span><span><small>移动额度</small><b><%= day.drive %></b></span></div><ol class="schedule"><% day.schedule.forEach(event=>{ %><li><span class="event-time"><%= event.time %></span><p><%= event.text %></p></li><% }) %></ol><% if(day.warning){ %><p class="day-warning"><strong>衔接提醒</strong><%= day.warning %></p><% } %></article><% }) %></div></div></section>
<section id="<%= trip.id %>-bookings" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">02 / RESERVATIONS</p><h2>报名要选什么，先核对再出发。</h2></div><p>产品与预约入口，不是订单。<br>重新选择日期和实际人数。</p></div><div class="booking-grid"><% trip.bookings.forEach(item=>{ %><article class="booking" id="booking-<%= item.id %>"><div class="booking-top"><span class="priority"><%= item.priority %></span><span><%= item.date %></span></div><p class="booking-en"><%= item.en %></p><h3><%= item.title %></h3><p class="booking-state"><%= item.state %></p><p class="price"><%= item.price %><small>参考口径 · 非付款确认价</small></p><p class="snapshot"><%= item.snapshot %></p><dl><% item.facts.forEach(fact=>{ %><div><dt><%= fact[0] %></dt><dd><%= fact[1] %></dd></div><% }) %></dl><div class="booking-links"><% item.links.forEach(link=>{ %><a class="book-link" href="<%= link[1] %>" target="_blank" rel="noopener noreferrer"><%= link[0] %> ↗</a><% }) %></div></article><% }) %></div></section>
<section class="chapter"><details class="extra"><summary>北岛附近推荐 · 待选，不计入当前基础预算</summary><div class="prose"><p>10/7 南岛还车，奥克兰三晚不变。优先保留霍比特含接送一日团，其他活动尽量留市区；不自动把原 Spellbound 换成普通 Waitomo。</p><% trip.northOptions.forEach(option=>{ %><h3><a href="<%= option.url %>" target="_blank" rel="noopener noreferrer"><%= option.name %> ↗</a></h3><p><%= option.duration %> · <%= travel_budget(option.price) %>／人</p><p><%= option.note %></p><p><strong>预算影响：</strong><%= option.budget_effect %></p><% }) %></div></details></section>
<section id="<%= trip.id %>-driving" class="chapter"><div class="section-heading"><div><p class="eyebrow">03 / ON THE ROAD</p><h2>车程只是起点，留白也算时间。</h2></div><p>纯驾驶 ≠ 门到门。<br>餐饮、停车、签到和休息另计。</p></div><div class="prose"><%- trip.sections.roads %></div><h3 class="subheading">一键打开目的地</h3><p class="section-note">地图为地点搜索入口，未取得实时路线。实际住宿地址与停车入口需按订单再核。</p><div class="map-links"><% trip.maps.forEach(route=>{ %><a href="<%= route.url %>" target="_blank" rel="noopener noreferrer"><span><%= route.title %></span><b>↗</b></a><% }) %></div></section>
<section id="<%= trip.id %>-flights" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">04 / FLIGHTS & CONNECTIONS</p><h2>国际往返已购，境内航段待订。</h2></div><p>国际票实付金额待补。<br>朋友提前离队安排待确认。</p></div><div class="prose"><%- trip.sections.flights %><p>用户确认往返已购，截图核验用户四段出票；未逐一核验同行订单。国际托运显示 2×23kg，不覆盖单买的国内票。</p></div><div class="booking-grid"><% trip.source.domestic_flights.forEach(f=>{ %><article class="booking"><div class="booking-top"><span><%= f.date %></span><span>未订</span></div><h3><%= f.origin %> → <%= f.destination %></h3><p class="booking-state">目标起飞 <%= f.departure_target %>；班次与全队余票未核</p><p class="price"><%= travel_budget(f.budget) %>／人<small>含一件托运的预算假设；不是已取得的含行李报价</small></p><p class="snapshot">公开展示 NZ$<%= f.public_display_from_nzd %> 起，查询于 <%= f.checked_on %>；不保证当前可售或目标时段。</p><div class="booking-links"><a class="book-link" href="<%= f.url %>" target="_blank" rel="noopener noreferrer">航司查询 ↗</a></div></article><% }) %></div></section>
<section id="<%= trip.id %>-stay" class="chapter"><div class="section-heading"><div><p class="eyebrow">05 / STAY & RENTALS</p><h2>九晚落点，南岛还车。</h2></div><p>偏好整套民宿／公寓。<br>暂按四成人两卧，床型待核。</p></div><div class="night-count"><div><b><%= trip.source.south_nights %></b><span>南岛住宿<br>Te Anau 一晚，按本方案日期入住</span></div><div><b><%= trip.source.north_nights %></b><span>北岛住宿<br>机场附近一晚 · 奥克兰市区三晚</span></div></div><div class="booking-grid"><% trip.stays.forEach(stay=>{ %><article class="booking" id="stay-<%= stay.id %>"><div class="booking-top"><span><%= stay.check_in %> → <%= stay.check_out %></span><span><%= stay.nights %> 晚</span></div><h3><%= stay.property.area %></h3><p class="booking-state">候选整套房 · 日期库存与最低连住待核</p><p class="price"><%= travel_budget(stay.budget) %><small>全队整段住宿预算，含清洁／服务／税费的目标总额；不是房源报价</small></p><p class="snapshot"><%= stay.property.name %><br><%= stay.property.features %></p><div class="booking-links"><a class="book-link" href="<%= stay.url %>" target="_blank" rel="noopener noreferrer">查看房源 ↗</a><% if(stay.property.alternative_url){ %><a class="text-link" href="<%= stay.property.alternative_url %>" target="_blank" rel="noopener noreferrer">备用房型 ↗</a><% } %></div></article><% }) %></div><div class="car-grid"><% trip.source.rentals.forEach(r=>{ %><article><p class="eyebrow"><%= r.region==='south'?'SOUTH ISLAND / ONE WAY':'NORTH ISLAND / AIRPORT RETURN' %></p><h3><%= r.region==='south'?trip.direction:'奥克兰市区取，机场还' %></h3><div class="prose"><p><%= r.pickup.replace('T',' ') %> 取 → <%= r.return_at.replace('T',' ') %> 还。<%= r.elapsed_hours %> 小时，按 <%= r.billed_days_budget %> 天预算。</p><p>一位司机；车型、箱数、保险与异地费用需按实际订单核实。北岛已确认不租车；报团出游，机场和市内短途使用预约接送／出租车。</p><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer">租车查询 ↗</a></div></article><% }) %></div></section>
<section id="<%= trip.id %>-prepare" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">06 / BEFORE YOU GO</p><h2>先打通依赖，再完成订单。</h2></div><p>预算与成交价分开。<br>国际票实付 F 尚待补充。</p></div><div class="prose"><p>按 <%= view.assumptions.adults %> 成人、整套两卧、一车估算；人数和床型未最终确认。汇率按 1 NZD＝¥<%= view.assumptions.cny_per_nzd_budget %>，不是银行成交价。</p><%- trip.sections.budget %><%- trip.sections.totals %><p><strong>个人总旅费＝上述含机动金人民币＋国际票实付 F＋签证／翻译 V＋中国境内交通 D＋自选 O。</strong>未知费用不按零元处理，第二件托运行李、买酒和自选体验另核。</p></div><details class="extra"><summary>预订前还需要确认什么</summary><div class="prose"><ul><li>实际人数、床型、司机驾照材料、行李空间、朋友提前离队安排。</li><li>按本方案日期确认境内班次、住宿含费总价、取消期限、晚到入住和行李寄存。</li><li>峡湾仅订船票；停车、山路驾驶和餐休另计。北岛霍比特团含交通与门票；额外景点待选，Airbnb 到团方接送点的衔接需核实。</li><li>以实际参与人数重新分摊；未预订项目不写成已锁位。</li></ul></div></details></section>
<footer class="travel-footer"><p class="eyebrow">KEEP THE PLAN. LEAVE ROOM FOR THE JOURNEY.</p><h2>把路书带上，把余地留下。</h2><p><%= trip.label %> · <%= trip.direction %> · 更新于 <%= view.updated %>。<br>住宿日期保留；链接与价格为查询参考。<%= view.mode==='compare'?'当前用于比较，最终方案尚未选定。':'当前为选定路线，订单仍需逐项核实。' %></p><div><a href="#plan-<%= trip.id %>">回到本方案顶部 ↑</a><a href="/new-zealand/wishlist/">景点愿望排序 ↗</a></div></footer>
</div><% }) %></main></body></html>
