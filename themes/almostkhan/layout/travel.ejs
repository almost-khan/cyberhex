---
layout: false
---
<% const trip = site.data.new_zealand; %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title %> · <%= config.title %></title>
<meta name="description" content="<%= page.description %>">
<% if (page.robots) { %><meta name="robots" content="<%= page.robots %>"><% } %>
<link rel="canonical" href="<%= full_url_for(page.path) %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.description %>">
<meta property="og:url" content="<%= full_url_for(page.path) %>">
<meta name="theme-color" content="#f7f5ee" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121714" media="(prefers-color-scheme: dark)">
<link rel="icon" href="<%= url_for(theme.favicon) %>">
<link rel="stylesheet" href="/css/travel.css">
<script defer src="/js/travel.js"></script>
</head>
<body>
<a class="skip" href="#timeline">跳至每日时间线</a>
<header class="sitebar"><a href="/" class="brand">AlmostKhan<span>旅行笔记</span></a><div><span class="edition">FIELD NOTES / 2026</span><button id="print-trip" type="button" hidden>打印 / 存为 PDF ↗</button></div></header>
<main>
<section class="hero" aria-labelledby="trip-title">
<div class="hero-copy"><p class="eyebrow">AOTEAROA / NEW ZEALAND</p><h1 id="trip-title">基督城进，皇后镇出，<br>六人一起<span>走遍南岛。</span></h1><p class="intro">从库克山下的冰川到米尔福德峡湾的峭壁，沿南岛一路向南；<br>北岛留给怀赫科岛的酒庄，和夏尔的一点绿意。</p><div class="hero-meta"><span>2026.10.01 — 10.11</span><span>11天 · 9晚</span><span>最终行程 <%= trip.version %></span></div><a class="primary" href="#timeline">展开每日行程 <span>↓</span></a></div>
<div class="route-art" aria-label="路线顺序示意，不代表真实地图或距离">
<div class="route-art-top"><span>THE JOURNEY</span><span>南岛 5 晚 / 北岛 4 晚</span></div>
<ol class="route-spine"><li><span>01</span><div><b>Auckland</b><small>10.01 入境 · 住机场附近</small></div><em>飞往南岛 ↘</em></li><li><span>02</span><div><b>Christchurch → Aoraki</b><small>10.02 基督城取车 · 库克山村</small></div></li><li><span>03</span><div><b>Wānaka → Te Anau</b><small>10.03—04 Hooker Valley徒步 · Te Anau休整</small></div></li><li><span>04</span><div><b>Milford → Queenstown</b><small>10.05—07 自驾峡湾 · 格林诺奇 · Skyline</small></div><em>飞回奥克兰 ↗</em></li><li><span>05</span><div><b>Waiheke + Hobbiton</b><small>10.08—09 六人→五人 · 酒庄 · 片场</small></div></li><li><span>06</span><div><b>Auckland → Home</b><small>10.10—11 国际返程 · 深圳中转</small></div></li></ol><p class="route-caption">路线顺序示意 · 基督城进，皇后镇出</p>
</div>
</section>
<div class="status-strip"><span class="status-dot"></span><p><strong>行程已定：基督城进、皇后镇出。</strong>依据 <%= trip.updated %> 的计划与查询记录整理；境内住宿、航班、租车和活动均未锁位，余位、价格不是实时结果。新西兰时刻为 NZDT（中国＋5小时），国际航段显示各地当地时间。</p></div>
<nav class="section-nav" aria-label="页面章节"><a href="#timeline">每日时间线</a><a href="#bookings">活动报名 <span><%= String(trip.bookings.length).padStart(2, '0') %></span></a><a href="#driving">车程与导航</a><a href="#flights">航班与分组</a><a href="#stay">住宿与租车</a><a href="#prepare">预算与待办</a></nav>
<section class="attention" aria-label="关注事项"><% trip.concerns.forEach(item => { %><article><span><%= item.tag %></span><h2><%= item.title %></h2><p><%= item.body %></p></article><% }) %></section>
<section id="timeline" class="chapter"><div class="section-heading"><div><p class="eyebrow">01 / DAY BY DAY</p><h2>每天怎么走，都在这里。</h2></div><p>司机负担标记：🔴 很累／最累；🟠 较累；🟡 驾驶不长但需看前日恢复；🟢 轻松；🚐 不自驾。<br>时间线是执行模型，真实航班、酒店和订单确认后整体校正。</p></div>
<div class="timeline-layout"><aside class="day-nav" aria-label="按日期跳转"><p>11 DAYS / 2026</p><% trip.days.forEach(day => { %><a href="#<%= day.id %>"><time datetime="<%= day.date %>"><%= day.short %></time><span><%= day.place.split(' → ')[0] %></span></a><% }) %></aside><div class="days">
<% trip.days.forEach((day, index) => { %><article class="day" id="<%= day.id %>" data-region="<%= day.region %>"><div class="day-top"><span class="day-number">DAY <%= String(index + 1).padStart(2, '0') %></span><time datetime="<%= day.date %>"><%= day.short %></time><% if (day.burden) { %><span class="burden burden-<%= day.burden.level %>"><%= day.burden.emoji %> <%= day.burden.label %></span><% } %><span class="region"><%= ({south:'南岛',north:'北岛',transit:'国际交通',split:'分组 · 六人→五人'})[day.region] %></span></div><h3><%= day.title %></h3><p class="day-place"><%= day.place %></p><p class="day-summary"><%= day.summary %></p><div class="day-facts"><span><small>今晚住哪</small><b><%= day.stay %></b></span><span><small>移动额度</small><b><%= day.drive %></b></span></div>
<ol class="schedule"><% day.schedule.forEach(event => { %><li><span class="event-time"><%= event.time %></span><p><%= event.text %></p></li><% }) %></ol>
<% if (day.warning) { %><p class="day-warning"><strong>衔接提醒</strong><%= day.warning %></p><% } %>
<% if (day.detail) { %><details class="day-detail"><summary>完整执行说明、装备与变更条件 <span>＋</span></summary><div class="prose"><%- travel_markdown(day.detail) %></div></details><% } %>
</article><% }) %></div></div></section>
<section id="bookings" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">02 / RESERVATIONS</p><h2>报名要选什么，先核对再出发。</h2></div><p>这里是查询与报名入口，不是订单。<br>所有项目均未付款、未锁位。</p></div><p class="section-note">日期一律选择 <strong>2026年</strong>，重选实际人数、语言和票种。住宿按六人阶段整套四卧查询；10/8起五人阶段拟三卧，或延续四卧连住。打开预订站后，检查页面是否保留日期、人数及房型条件。</p>
<div class="booking-grid"><% trip.bookings.forEach(item => { %><article class="booking" id="booking-<%= item.id %>"><div class="booking-top"><span class="priority"><%= item.priority %></span><span><%= item.date %></span></div><p class="booking-en"><%= item.en %></p><h3><%= item.title %></h3><p class="booking-state"><%= item.state %></p><p class="price"><%= item.price %><small>参考口径 · 非付款确认价</small></p><p class="snapshot"><%= item.snapshot %></p><dl><% item.facts.forEach(fact => { %><div><dt><%= fact[0] %></dt><dd><%= fact[1] %></dd></div><% }) %></dl><div class="booking-links"><% item.links.forEach((link,i) => { %><a class="<%= i===0?'book-link':'text-link' %>" href="<%= link[1] %>" target="_blank" rel="noopener noreferrer"><%= link[0] %> ↗</a><% }) %></div></article><% }) %></div>
</section>
<section id="driving" class="chapter"><div class="section-heading"><div><p class="eyebrow">03 / ON THE ROAD</p><h2>车程只是起点，留白也算时间。</h2></div><p>纯驾驶 ≠ 门到门。<br>餐饮、停车、签到和休息单独计入。</p></div><div class="prose"><%- travel_markdown(trip.sections.roads) %></div><h3 class="subheading">一键打开路线</h3><p class="section-note">导航链接未预加载地图。起终点已写入；实际酒店／门店未定的路段仍需替换地址，页面未获取实时交通。米尔福德峡湾为自驾到码头，仅乘船，不跟大巴团。</p><div class="map-links"><% trip.maps.forEach(route => { %><a href="<%= route.url %>" target="_blank" rel="noopener noreferrer"><span><%= route.title %></span><b>↗</b></a><% }) %></div></section>
<section id="flights" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">04 / FLIGHTS & CONNECTIONS</p><h2>同程出发，分开返航。</h2></div><p>截图票与规划模型分开列。<br>未编造航班号、订单或已出票状态。</p></div><div class="prose"><%- travel_markdown(trip.sections.flights) %></div><details class="extra"><summary>国内票查询记录与操作入口</summary><div class="prose"><%- travel_markdown(trip.sections.flightQuery) %></div></details></section>
<section id="stay" class="chapter"><div class="section-heading"><div><p class="eyebrow">05 / STAY & RENTALS</p><h2>九晚落点，一段租车。</h2></div><p>六人共同住七晚，10/8起五人在奥克兰再住两晚。<br>南岛自驾，北岛全程不租车。</p></div><div class="night-count"><div><b>5</b><span>南岛住宿<br>库克山村 1 · 瓦纳卡 1 · Te Anau 1 · 皇后镇 2</span></div><div><b>4</b><span>北岛住宿<br>入境夜机场附近 1 · 奥克兰市区 3（10/8起5人）</span></div></div><div class="prose"><%- travel_markdown(trip.sections.hotels) %></div><div class="car-grid"><article><p class="eyebrow">SOUTH ISLAND / ONE WAY</p><h3>基督城取，皇后镇还</h3><div class="prose"><%- travel_markdown(trip.sections.southCar) %></div></article><article><p class="eyebrow">NORTH ISLAND / NO SELF-DRIVE</p><h3>北岛不租车，接驳与跟团解决</h3><div class="prose"><p><strong>10/7落地奥克兰起，全程不再自驾。</strong>机场到市区用预约接送或出租车，不取北岛车；10/8自行步行／打车到市区码头，搭渡轮后由酒庄团提供岛上交通；10/9霍比特村团从指定集合点接送，本人驾驶为0。</p><p>10/10离境同样用预约接送或出租车前往国际航站楼；需先落实能容纳五人行李的寄存点，再按实际行李数量预订接送车。</p><p>不安排两名司机轮换或额外驾照翻译；北岛全程无需租车保险、油费或停车费。</p></div></article></div></section>
<section id="prepare" class="chapter tinted"><div class="section-heading"><div><p class="eyebrow">06 / BEFORE YOU GO</p><h2>先打通依赖，再完成订单。</h2></div><p>人数已定为六人；住宿房型、航班座位与预算仍待落实。<br>没有用旧路线总价冒充本次预算。</p></div><div class="prose"><%- travel_markdown(trip.sections.priorities) %></div><h3 class="subheading">预算如何计算</h3><div class="prose"><%- travel_markdown(trip.sections.budget) %></div><details class="extra"><summary>全部待预订清单、驾照、退款与出行准备</summary><div class="prose"><%- travel_markdown(trip.sections.prerequisites) %></div></details><details class="extra"><summary>路线取舍与同行约定</summary><div class="prose"><%- travel_markdown(trip.sections.principles) %></div></details><details class="extra"><summary>参考资料、路线研究与出发前复核</summary><div class="prose"><%- travel_markdown(trip.sections.research) %></div></details></section>
<footer class="travel-footer"><p class="eyebrow">KEEP THE PLAN. LEAVE ROOM FOR THE JOURNEY.</p><h2>把路书带上，把余地留下。</h2><p>整理自《新西兰旅行计划》<%= trip.version %> 与整体审核、预订清单，记录更新于 <%= trip.updated %>。<br>本页未实时刷新库存、下单或付款。</p><div><a href="/">← 返回 AlmostKhan</a><a href="#trip-title">回到顶部 ↑</a></div></footer>
</main>
</body>
</html>
